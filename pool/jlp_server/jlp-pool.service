[Unit]
Description=StarMiner JLP Kangaroo Pool Server (Puzzle #135)
After=network.target puzzle-pool.service

[Service]
Type=simple
WorkingDirectory=/home/monga/collider-star/pool/jlp_server
ExecStart=/usr/bin/python3 server.py --host 0.0.0.0 --port 17403 --db /home/monga/btc-puzzle-pool/data/pool_dps.db
Restart=always
RestartSec=5
User=monga
Environment=PYTHONUNBUFFERED=1

[Install]
WantedBy=multi-user.target
